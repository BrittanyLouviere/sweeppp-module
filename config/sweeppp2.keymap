#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/bt.h>

&nice_view_spi {
    cs-gpios = <&pro_micro 2 GPIO_ACTIVE_HIGH>;
};

/ {
    combos {
        compatible = "zmk,combos";

        c1 { bindings = <&kp A>; key-positions = <10>; };
        c2 { bindings = <&kp O>; key-positions = <11>; };
        c3 { bindings = <&kp E>; key-positions = <12>; };
        c4 { bindings = <&kp U>; key-positions = <12 13>; };
        c5 { bindings = <&kp I>; key-positions = <13>; };
        c6 { bindings = <&kp D>; key-positions = <16 17>; };
        c7 { bindings = <&kp H>; key-positions = <16>; };
        c8 { bindings = <&kp T>; key-positions = <17>; };
        c9 { bindings = <&kp N>; key-positions = <18>; };
        c10 { bindings = <&kp S>; key-positions = <19>; };
        c11 { bindings = <&kp SQT>; key-positions = <10 18>; };
        c12 { bindings = <&kp COMMA>; key-positions = <10 11>; };
        c13 { bindings = <&kp DOT>; key-positions = <11 12>; };
        c14 { bindings = <&kp P>; key-positions = <10 13>; };
        c15 { bindings = <&kp Y>; key-positions = <11 13>; };
        c16 { bindings = <&kp F>; key-positions = <13 16>; };
        c17 { bindings = <&kp G>; key-positions = <16 18>; };
        c18 { bindings = <&kp C>; key-positions = <12 17>; };
        c19 { bindings = <&kp R>; key-positions = <17 18>; };
        c20 { bindings = <&kp L>; key-positions = <18 19>; };
        c21 { bindings = <&kp SEMI>; key-positions = <10 16>; };
        c22 { bindings = <&kp Q>; key-positions = <11 18>; };
        c23 { bindings = <&kp J>; key-positions = <12 16>; };
        c24 { bindings = <&kp K>; key-positions = <13 17>; };
        c25 { bindings = <&kp X>; key-positions = <13 18>; };
        c26 { bindings = <&kp B>; key-positions = <11 16>; };
        c27 { bindings = <&kp M>; key-positions = <16 19>; };
        c28 { bindings = <&kp W>; key-positions = <11 17>; };
        c29 { bindings = <&kp V>; key-positions = <12 18>; };
        c30 { bindings = <&kp Z>; key-positions = <17 19>; };
        c31 { bindings = <&kp NUBS>; key-positions = <10 19>; };
        c32 { bindings = <&kp FSLH>; key-positions = <13 19>; };
        c33 { bindings = <&kp LBKT>; key-positions = <10 17>; };
        c34 { bindings = <&kp RBKT>; key-positions = <12 19>; };
        c35 { bindings = <&kp ESC>; key-positions = <11 19>; };
        c36 { bindings = <&kp TAB>; key-positions = <10 12>; };
        c37 { bindings = <&kp GRAVE>; key-positions = <11 12 13>; };
        c38 { bindings = <&kp N1>; key-positions = <12 13 16>; };
        c39 { bindings = <&kp N2>; key-positions = <12 13 17>; };
        c40 { bindings = <&kp N3>; key-positions = <12 13 18>; };
        c41 { bindings = <&kp N4>; key-positions = <12 13 19>; };
        c42 { bindings = <&kp N5>; key-positions = <11 12 16>; };
        c43 { bindings = <&kp N6>; key-positions = <11 12 17>; };
        c44 { bindings = <&kp N7>; key-positions = <11 12 18>; };
        c45 { bindings = <&kp N8>; key-positions = <11 12 19>; };
        c46 { bindings = <&kp N9>; key-positions = <10 11 16>; };
        c47 { bindings = <&kp N0>; key-positions = <10 11 17>; };
        c48 { bindings = <&kp EQUAL>; key-positions = <10 11 18>; };
        c49 { bindings = <&kp MINUS>; key-positions = <10 11 19>; };
        c50 { bindings = <&kp F1>; key-positions = <13 16 17>; };
        c51 { bindings = <&kp F2>; key-positions = <12 16 17>; };
        c52 { bindings = <&kp F3>; key-positions = <11 16 17>; };
        c53 { bindings = <&kp F4>; key-positions = <10 16 17>; };
        c54 { bindings = <&kp F5>; key-positions = <13 17 18>; };
        c55 { bindings = <&kp F6>; key-positions = <12 17 18>; };
        c56 { bindings = <&kp F7>; key-positions = <11 17 18>; };
        c57 { bindings = <&kp F8>; key-positions = <10 17 18>; };
        c58 { bindings = <&kp F9>; key-positions = <13 18 19>; };
        c59 { bindings = <&kp F10>; key-positions = <12 18 19>; };
        c60 { bindings = <&kp F11>; key-positions = <11 18 19>; };
        c61 { bindings = <&kp F12>; key-positions = <10 18 19>; };
        c101 { bindings = <&kp DEL>; key-positions = <23>; };
        c102 { bindings = <&kp BSPC>; key-positions = <34>; };
        c103 { bindings = <&kp SPACE>; key-positions = <35>; };
        c104 { bindings = <&kp ENTER>; key-positions = <36>; };
        c105 { bindings = <&kp LCTRL>; key-positions = <28>; };
        c106 { bindings = <&kp LALT>; key-positions = <39>; };
        c107 { bindings = <&kp LSHFT>; key-positions = <40>; };
        c108 { bindings = <&kp LMETA>; key-positions = <41>; };
        c109 { bindings = <&kp UP>; key-positions = <16 17 18 23>; };
        c110 { bindings = <&kp LEFT>; key-positions = <16 17 18 34>; };
        c111 { bindings = <&kp DOWN>; key-positions = <16 17 18 35>; };
        c112 { bindings = <&kp RIGHT>; key-positions = <16 17 18 36>; };
        c113 { bindings = <&kp PG_UP>; key-positions = <10 11 12 28>; };
        c114 { bindings = <&kp HOME>; key-positions = <10 11 12 39>; };
        c115 { bindings = <&kp PG_DN>; key-positions = <10 11 12 40>; };
        c116 { bindings = <&kp END>; key-positions = <10 11 12 41>; };
        
        c118 { bindings = <&bt BT_SEL 0>; key-positions = <11 12 13 16>; };
        c119 { bindings = <&bt BT_SEL 1>; key-positions = <11 12 13 17>; };
        c120 { bindings = <&bt BT_SEL 2>; key-positions = <11 12 13 18>; };
        c121 { bindings = <&bt BT_SEL 3>; key-positions = <11 12 13 19>; };
        c122 { bindings = <&bt BT_SEL 4>; key-positions = <10 11 12 16>; };
        c123 { bindings = <&bt BT_CLR>; key-positions = <10 11 12 19>; };
    };

    keymap {
        compatible = "zmk,keymap";

        default_layer {
            bindings = <
        //╭───────┬───────┬───────┬───────┬───────╮                   ╭───────┬───────┬───────┬───────┬───────╮
        //│       │       │       │       │       │                   │       │       │       │       │       │
            &none   &none   &none   &none   &none                       &none   &none   &none   &none   &none  
        //├───────┼───────┼───────┼───────┼───────┤                   ├───────┼───────┼───────┼───────┼───────┤
        //│       │       │       │       │       │                   │       │       │       │       │       │
            &none   &none   &none   &none   &none                       &none   &none   &none   &none   &none  
        //├───────┼───────┼───────┼───────┼───────┼───────╮   ╭───────┼───────┼───────┼───────┼───────┼───────┤
        //│       │       │       │       │       │                   │       │       │       │       │       │
            &none   &none   &none   &none   &none   &none       &none   &none   &none    &none  &none   &none  
        //├───────┼───────┼───────┼───────┼───────┼───────┤   ├───────┼───────┼───────┼───────┼───────┼───────┤
        //│       │       │       │       │       │                   │       │       │       │       │       │
            &none   &none   &none   &none   &none   &none       &none   &none   &none   &none   &none   &none  
        //╰───────┴───────┼───────┼───────┼───────┼───────┤   ├───────┼───────┼───────┼───────┼───────┴───────╯
        //                │       │       │       │       │   │       │       │       │       │
                            &none   &none   &none   &none       &none   &none   &none   &none  
        //                ╰───────┴───────┴───────┴───────╯   ╰───────┴───────┴───────┴───────╯
            >;
        };
    };
 };

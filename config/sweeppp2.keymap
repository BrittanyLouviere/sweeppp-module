#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/bt.h>

&nice_view_spi {
    cs-gpios = <&pro_micro 2 GPIO_ACTIVE_HIGH>;
};

/ {
    combos {
        compatible = "zmk,combos";

        c11 { bindings = <&kp SQT>; key-positions = <0 8>; };
        c12 { bindings = <&kp COMMA>; key-positions = <0 1>; };
        c13 { bindings = <&kp DOT>; key-positions = <1 2>; };
        c14 { bindings = <&kp P>; key-positions = <0 3>; };
        c15 { bindings = <&kp Y>; key-positions = <1 3>; };
        c16 { bindings = <&kp F>; key-positions = <3 6>; };
        c17 { bindings = <&kp G>; key-positions = <6 8>; };
        c18 { bindings = <&kp C>; key-positions = <2 7>; };
        c19 { bindings = <&kp R>; key-positions = <7 8>; };
        c20 { bindings = <&kp L>; key-positions = <8 9>; };
        c21 { bindings = <&kp SEMI>; key-positions = <0 6>; };
        c22 { bindings = <&kp Q>; key-positions = <1 8>; };
        c23 { bindings = <&kp J>; key-positions = <2 6>; };
        c24 { bindings = <&kp K>; key-positions = <3 7>; };
        c25 { bindings = <&kp X>; key-positions = <3 8>; };
        c26 { bindings = <&kp B>; key-positions = <1 6>; };
        c27 { bindings = <&kp M>; key-positions = <6 9>; };
        c28 { bindings = <&kp W>; key-positions = <1 7>; };
        c29 { bindings = <&kp V>; key-positions = <2 8>; };
        c30 { bindings = <&kp Z>; key-positions = <7 9>; };
    };

    keymap {
        compatible = "zmk,keymap";

        default_layer {
            bindings = <
        //╭───────┬───────┬───────┬───────┬───────╮                   ╭───────┬───────┬───────┬───────┬───────╮
        //│       │       │       │       │       │                   │       │       │       │       │       │
            &none   &none   &none   &none   &none                       &none   &none   &none   &none   &none  
        //├───────┼───────┼───────┼───────┼───────┤                   ├───────┼───────┼───────┼───────┼───────┤
        //│       │       │       │       │       │                   │       │       │       │       │       │
            &none   &none   &none   &none   &none                       &none   &none   &none   &none   &none  
        //├───────┼───────┼───────┼───────┼───────┼───────╮   ╭───────┼───────┼───────┼───────┼───────┼───────┤
        //│       │       │       │       │       │                   │       │       │       │       │       │
            &none   &none   &none   &none   &none   &none       &none   &none   &none    &none  &none   &none  
        //├───────┼───────┼───────┼───────┼───────┼───────┤   ├───────┼───────┼───────┼───────┼───────┼───────┤
        //│       │       │       │       │       │                   │       │       │       │       │       │
            &none   &none   &none   &none   &none   &none       &none   &none   &none   &none   &none   &none  
        //╰───────┴───────┼───────┼───────┼───────┼───────┤   ├───────┼───────┼───────┼───────┼───────┴───────╯
        //                │       │       │       │       │   │       │       │       │       │
                            &none   &none   &none   &none       &none   &none   &none   &none  
        //                ╰───────┴───────┴───────┴───────╯   ╰───────┴───────┴───────┴───────╯
            >;
        };
    };
 };
